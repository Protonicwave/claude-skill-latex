{
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (latexmkrc)",
      "tools": ["latexmk-rc"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-rc",
      "command": "latexmk",
      "args": ["-interaction=nonstopmode", "%DOC%"]
    }
  ],
  "latex-workshop.latex.outDir": "%DIR%/build"
}
