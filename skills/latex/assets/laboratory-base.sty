% Laboratory house style: the type, maths, units, colours and title record
% strip that documents, slides and posters share. laboratory.sty and
% beamerthemeLaboratory.sty load it.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{laboratory-base}[2026/11/07 Laboratory house style: type and maths]

\RequirePackage{iftex}
\RequireLuaTeX

\RequirePackage[british]{babel}
\RequirePackage{amsmath}
\RequirePackage{mathtools}
\RequirePackage{fontspec}
% Both notices only say that unicode-math replaces a few mathtools commands
% with its own; neither is a fault in the document.
\RequirePackage[warnings-off={mathtools-colon,mathtools-overbracket}]{unicode-math}
\RequirePackage{microtype}
\RequirePackage{etoolbox}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{colortbl}
\RequirePackage{tikz}
\RequirePackage{siunitx}
\RequirePackage{csquotes}
% \path sets the record strip's source in monospace, breaking after a slash or
% a dot, so a long repository address wraps within its column.
\RequirePackage{url}
\RequirePackage[numbers,sort&compress]{natbib}

% Erewhon for text and maths, Source Sans 3 for every piece of furniture,
% IBM Plex Mono for code. figures/laboratory.mplstyle names the same faces.
\setmainfont{Erewhon}[
  Extension = .otf,
  UprightFont = *-Regular,
  BoldFont = *-Bold,
  ItalicFont = *-Italic,
  BoldItalicFont = *-BoldItalic,
  Scale = 0.95,
]
\setmathfont{Erewhon-Math.otf}[Scale = 0.95]
\setsansfont{SourceSans3}[
  Extension = .otf,
  UprightFont = *-Regular,
  BoldFont = *-Semibold,
  ItalicFont = *-RegularIt,
  BoldItalicFont = *-SemiboldIt,
  Scale = MatchUppercase,
]
\setmonofont{IBMPlexMono}[
  Extension = .otf,
  UprightFont = *-Regular,
  BoldFont = *-SemiBold,
  ItalicFont = *-Italic,
  Scale = MatchLowercase,
]

% Erewhon Math's solidus carries wide side-bearings, so J/k reads as "J / k".
% Every maths slash is pulled in by 2 mu on each side; text slashes are untouched.
\AtBeginDocument{%
  \Umathcharnumdef\laboratoryslash=\Umathcodenum`\/\relax
  \begingroup\lccode`\~=`\/\lowercase{\endgroup\def~}{\mkern-2mu\laboratoryslash\mkern-2mu}%
  \mathcode`\/="8000\relax
}

\definecolor{prussian}{HTML}{1F4A73}
\definecolor{rulegrey}{gray}{0.6}
\definecolor{laboratory@unitgrey}{gray}{0.4}

% The data colours, so a caption, tag or table can name the colour a figure
% gives a series. A document gives one a meaning with \colorlet, for example
% \colorlet{stuck}{seriesB}.
\colorlet{seriesA}{prussian}
\definecolor{seriesB}{HTML}{B5562C}
\definecolor{seriesC}{HTML}{1A1A1A}
\definecolor{seriesD}{HTML}{737373}

% One space after a full stop, so "e.g." and initials need no manual spacing.
\frenchspacing

% ISO 80000-2 sets the differential upright, with a thin space before it.
\newcommand{\dd}{\mathop{}\!\mathrm{d}}

% A proper name the British patterns do not break.
\babelhyphenation[british]{Boltz-mann}

\sisetup{
  separate-uncertainty = false,
  group-minimum-digits = 5,
  % A quantity takes the face and weight around it, so one in a sans caption
  % or a bold head matches the words beside it.
  mode = match,
  reset-text-family = false,
  reset-text-series = false,
}
% Numbers in a table stay in maths, so a signed entry keeps its true minus
% whatever face its cell is set in.
\AtBeginEnvironment{tabular}{\sisetup{mode = math}}
\AtBeginEnvironment{tabular*}{\sisetup{mode = math}}
\AtBeginEnvironment{tabularx}{\sisetup{mode = math}}

% Capitals set as a label are tracked open, or they crowd.
\newcommand{\laboratory@tracked}[1]{{\addfontfeature{LetterSpace=8}\MakeUppercase{#1}}}

% Table rules repeat the record strip: a Prussian rule above, grey rules inside
% and a black rule to close the table. The top rule's width is fixed here, so
% \toprule takes no optional width.
\setlength{\heavyrulewidth}{0.6pt}
\setlength{\lightrulewidth}{0.4pt}
\setlength{\cmidrulewidth}{0.4pt}
\let\laboratory@toprule\toprule
\let\laboratory@midrule\midrule
\let\laboratory@bottomrule\bottomrule
\renewcommand{\toprule}{\arrayrulecolor{prussian}\laboratory@toprule[1pt]\arrayrulecolor{rulegrey}}
\renewcommand{\midrule}{\arrayrulecolor{rulegrey}\laboratory@midrule}
\renewcommand{\bottomrule}{\arrayrulecolor{black}\laboratory@bottomrule}

% Table column headings are furniture, so they take the sans face. They stay at
% regular weight: most heads hold a quantity in maths, which has no bold to
% match, so a bold word beside them sets two weights in one row.
\newcommand{\head}[1]{{\sffamily #1}}
% A head with its unit under it in small grey sans, written as siunitx unit
% macros. With no unit, a strut of the unit's height keeps the head level with
% its neighbours.
\NewDocumentCommand{\colhead}{mm}{%
  \begin{tabular}[b]{@{}c@{}}%
    \head{#1}\\[-0.2ex]
    {\sffamily\footnotesize\color{laboratory@unitgrey}%
      \if\relax\detokenize{#2}\relax\strut\else\unit[mode = text]{#2}\fi}%
  \end{tabular}}
% The name of a group of columns, set like the record strip's labels.
\NewDocumentCommand{\spanhead}{m}{{\sffamily\footnotesize\color{prussian}\laboratory@tracked{#1}}}
% The one row a reader should find first.
\newcommand{\keyrow}{\rowcolor{prussian!7}}
% Alternate rows of a wide table of words, in a neutral tint so the Prussian of
% \keyrow keeps its meaning.
\newcommand{\band}{\rowcolor{black!4}}

% A coloured chip of small bold sans: background, text colour, text.
\newcommand{\laboratory@chip}[3]{%
  {\setlength{\fboxsep}{1.4pt}\colorbox{#1}{\rule[-0.25ex]{0pt}{1.75ex}\sffamily\footnotesize\bfseries\color{#2}#3}}}
% Likelihood or impact in a risk table, light to dark.
\NewDocumentCommand{\level}{m}{%
  \ifstrequal{#1}{low}{\laboratory@chip{black!6}{black}{\mdseries low}}{%
  \ifstrequal{#1}{medium}{\laboratory@chip{black!18}{black}{\mdseries medium}}{%
  \ifstrequal{#1}{high}{\laboratory@chip{black!72}{white}{\mdseries high}}{%
  \PackageError{laboratory-base}{Unknown level `#1'}{\string\level\space takes low, medium or high.}}}}}

% Coded tags such as H1, R2 or MS3. \definebadge gives a code its colour once;
% \badge sets the code anywhere as a chip that links to the one place
% \badgetarget sets it. A code with no colour of its own is Prussian.
\newcommand{\definebadge}[2]{\csdef{laboratory@badge@#1}{#2}}
\newcommand{\laboratory@badgecolour}[1]{\ifcsdef{laboratory@badge@#1}{\csuse{laboratory@badge@#1}}{prussian}}
\NewDocumentCommand{\badge}{m}{\hyperlink{badge.#1}{\laboratory@chip{\laboratory@badgecolour{#1}}{white}{#1}}}
\NewDocumentCommand{\badgetarget}{m}{\hypertarget{badge.#1}{\laboratory@chip{\laboratory@badgecolour{#1}}{white}{#1}}}

% Keys in a caption or the text that match a figure's marks.
\NewDocumentCommand{\marker}{m}{\tikz[baseline=-0.6ex]\fill[#1] (0,0) circle (0.27em);}
\NewDocumentCommand{\linekey}{m}{\tikz[baseline=-0.6ex]\draw[#1, line width=0.9pt] (0,0) -- (1.1em,0);}

% The bold first sentence of a caption, which says what the float shows.
\NewDocumentCommand{\lead}{m}{{\bfseries #1}}

% Where the work behind the document lives: a repository, notebook or data
% folder. The record strip leaves the field out when it is not given.
\newcommand{\laboratory@source}{}
\newcommand{\source}[1]{\renewcommand{\laboratory@source}{#1}}
% The supervisor of a project, left out of the record strip when not given.
\newcommand{\laboratory@supervisor}{}
\newcommand{\supervisor}[1]{\renewcommand{\laboratory@supervisor}{#1}}

% Sizes of the record strip, which the poster theme scales up for the sheet.
\newcommand{\laboratory@labelsize}{\footnotesize}
\newcommand{\laboratory@valuesize}{\small}
\newlength{\laboratory@accentrule}
\setlength{\laboratory@accentrule}{1.2pt}
\newlength{\laboratory@hairline}
\setlength{\laboratory@hairline}{0.4pt}

% Each line ends its paragraph inside its own size, so it takes its own leading.
% Values are ragged right: a name too long for its column wraps rather than
% being stretched across it.
\newcommand{\laboratory@field}[2]{%
  {\sffamily\laboratory@labelsize\color{prussian}\laboratory@tracked{#1}\par}%
  {\raggedright\sffamily\laboratory@valuesize #2\par}%
}

% The fields of the record strip in a row: the supervisor's column (empty when
% there is none), the supervisor's cell with its column separator, the author
% and the date. The date column holds the longest British date, 28th September
% 2026, on one line at the slide's 140 mm measure.
\newcommand{\laboratory@recordfields}[4]{%
  \begin{tabularx}{\linewidth}{@{}p{0.22\linewidth}#1p{0.25\linewidth}X@{}}
    \laboratory@field{Author}{#3} & #2\laboratory@field{Date}{#4}
    & \ifx\laboratory@source\@empty\else\laboratory@field{Source}{\expandafter\path\expandafter{\laboratory@source}}\fi
  \end{tabularx}}

% The house signature under every title: a Prussian rule, the author,
% supervisor, date and source, and a grey rule. Takes the author and the date.
\newcommand{\laboratory@recordstrip}[2]{%
  {\color{prussian}\hrule height \laboratory@accentrule}%
  \vspace{0.6\baselineskip}%
  \noindent
  \ifx\laboratory@supervisor\@empty
    \laboratory@recordfields{}{}{#1}{#2}%
  \else
    \laboratory@recordfields{p{0.22\linewidth}}
      {\laboratory@field{Supervisor}{\laboratory@supervisor} &}{#1}{#2}%
  \fi
  \vspace{0.6\baselineskip}%
  {\color{rulegrey}\hrule height \laboratory@hairline}%
}
